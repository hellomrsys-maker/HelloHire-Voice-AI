{
  "patronymic_rules": {
    "masculine": {
      "hard_consonant": "ович",
      "soft_or_j": "евич",
      "exceptions": {
        "Илья": "Ильич",
        "Никита": "Никитич",
        "Кузьма": "Кузьмич",
        "Лука": "Лукич",
        "Фома": "Фомич",
        "Пётр": "Петрович",
        "Петр": "Петрович",
        "Лев": "Львович",
        "Павел": "Павлович"
      }
    },
    "feminine": {
      "hard_consonant": "овна",
      "soft_or_j": "евна",
      "exceptions": {
        "Илья": "Ильинична",
        "Никита": "Никитична",
        "Кузьма": "Кузьминична",
        "Лука": "Лукинична",
        "Фома": "Фоминична",
        "Пётр": "Петровна",
        "Петр": "Петровна",
        "Лев": "Львовна",
        "Павел": "Павловна"
      }
    }

  },
  "registers": {
    "formal_business": {
      "salutations": [
        "Уважаемый {name}!",
        "Уважаемая {name}!",
        "Здравствуйте, {name}!",
        "Добрый день, {name}!"
      ],
      "valedictions": [
        "С уважением,",
        "С наилучшими пожеланиями,"
      ],
      "pronoun": "Вы",
      "t_v_honorific": true
    },
    "official_academic": {
      "salutations": [
        "Глубокоуважаемый {name}!",
        "Глубокоуважаемая {name}!"
      ],
      "valedictions": [
        "Искренне Ваш,",
        "Искренне Ваша,",
        "С глубоким почтением,"
      ],
      "pronoun": "Вы",
      "t_v_honorific": true
    },
    "informal_friendly": {
      "salutations": [
        "Привет, {name}!",
        "Здравствуй, {name}!"
      ],
      "valedictions": [
        "Всего доброго!",
        "До скорого!",
        "Удачи!"
      ],
      "pronoun": "ты",
      "t_v_honorific": false
    }
  }
}
