  "crase_rules": {
    "description": "Fusion of preposition 'a' with feminine article 'a' or demonstrative 'aquele'",
    "mandatory_cases": [
      "before_feminine_nouns_governed_by_prep_a",
      "locutions_feminine (à noite, às vezes, à medida que, às pressas)",
      "demonstratives_aquele (fui àquele lugar)"
    ],
    "prohibited_cases": [
      "before_masculine_nouns (a pé, a cavalo)",
