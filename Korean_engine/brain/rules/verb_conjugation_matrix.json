{
  "irregular_paradigms": {
    "ㄷ_irregular": {
      "stems": ["듣", "걷", "묻", "싣", "긷", "깨닫"],
      "rule": "ㄷ becomes ㄹ before vowels",
      "present_haeyo": {"듣다": "들어요", "걷다": "걸어요", "묻다": "물어요"}
    },
    "ㅂ_irregular": {
      "stems": ["춥", "덥", "돕", "곱", "어렵", "쉽", "맵", "무겁", "가볍", "아름답"],
      "rule": "ㅂ drops and becomes 우 (or 오 after ㅗ) before vowels",
      "present_haeyo": {"춥다": "추워요", "덥다": "더워요", "돕다": "도와요", "어렵다": "어려워요"}
    },
    "ㅅ_irregular": {
      "stems": ["짓", "낫", "붓", "잇", "젓"],
      "rule": "ㅅ drops before vowels without diphthong coalescence",
      "present_haeyo": {"짓다": "지어요", "낫다": "나아요", "붓다": "부어요"}
    },
    "르_irregular": {
      "stems": ["빠르", "부르", "모르", "고르", "기르", "오르", "흐르"],
      "rule": "으 drops and preceding syllable takes ㄹ batchim before vowels",
      "present_haeyo": {"빠르다": "빨라요", "부르다": "불러요", "모르다": "몰라요"}
    },
    "으_drop": {
      "stems": ["크", "쓰", "뜨", "끄", "바쁘", "아프", "슬프", "예쁘"],
      "rule": "으 drops before -아/어 suffixes",
      "present_haeyo": {"크다": "커요", "쓰다": "써요", "바쁘다": "바빠요", "예쁘다": "예뻐요"}
    },
    "ㅎ_irregular": {
      "stems": ["그렇", "이렇", "저렇", "어떻", "파랗", "하얗", "노랗", "빨갛"],
      "rule": "ㅎ drops and vowel fuses with -아/어 to form 애/얘",
      "present_haeyo": {"그렇다": "그래요", "어떻다": "어때요", "파랗다": "파래요"}
    },
    "여_irregular": {
      "stems": ["하"],
      "rule": "하 combines with 여 to form 해",
      "present_haeyo": {"하다": "해요", "공부하다": "공부해요"}
    }
  },
