        { "root": "voc / vok", "meaning": "voice / call", "derivatives": ["vocal", "revoke", "provoke", "vocabulary"] },
        { "root": "struct", "meaning": "build", "derivatives": ["structure", "construct", "destruct", "instruct"] },
